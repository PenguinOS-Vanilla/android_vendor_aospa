# Allow Pentas to read GPU load, GPU clock and battery state. The qcom policy already
# lets every domain search the kgsl directory, but ueventd's restorecon of /sys relabels
# every kgsl-3d0 node (gpubusy included) vendor_sysfs_kgsl, and gpuclk vendor_sysfs_kgsl_gpuclk.
allow system_app vendor_sysfs_kgsl:file r_file_perms;
allow system_app vendor_sysfs_kgsl:lnk_file r_file_perms;
allow system_app vendor_sysfs_kgsl_gpuclk:file r_file_perms;
allow system_app vendor_sysfs_battery_supply:dir r_dir_perms;
allow system_app vendor_sysfs_battery_supply:file r_file_perms;
